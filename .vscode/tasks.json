{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Lint profile and sign out changes",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Build profile page and logout",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Rebuild profile and logout",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Lint profile features",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Stage project files for initial push",
			"type": "shell",
			"command": "git add -A -- . ':(exclude)nul'; if ($?) { git status --short --branch; git diff --cached --stat; git diff --cached --check }",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}